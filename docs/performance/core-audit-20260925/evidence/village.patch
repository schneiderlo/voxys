+// Admission only asks whether any reservation overlaps. Keep the exact narrow
+// predicate while excluding X intervals that cannot meet its strict bounds.
+class VillageReservations {
+    struct Entry {const Solid* solid;double lower,prefixUpper;};
+    std::span<const Solid> source_;
+    std::vector<Entry> entries_;
+    std::vector<Entry>::difference_type finiteCount_=0;
+public:
+    explicit VillageReservations(std::span<const Solid> source):source_(source) {
+        entries_.reserve(source.size());
+        for(const auto& solid:source)entries_.push_back({&solid,solid.minimum.x-.5,solid.maximum.x+.5});
+        const auto finiteEnd=std::partition(entries_.begin(),entries_.end(),[](const Entry& entry){
+            return std::isfinite(entry.lower)&&std::isfinite(entry.prefixUpper);
+        });
+        finiteCount_=finiteEnd-entries_.begin();
+        std::sort(entries_.begin(),finiteEnd,[](const Entry& a,const Entry& b){return a.lower<b.lower;});
+        double upper=-INFINITY;
+        for(auto it=entries_.begin();it!=finiteEnd;++it) {
+            upper=std::max(upper,it->prefixUpper);it->prefixUpper=upper;
+        }
+    }
+    bool blocks(glm::dvec3 lo,glm::dvec3 hi) const {
+        for(int axis=0;axis<3;++axis)if(!std::isfinite(lo[axis])||!std::isfinite(hi[axis])) {
+            for(const auto& solid:source_)if(overlap(lo,hi,solid,.5))return true;
+            return false;
+        }
+        const auto finiteEnd=entries_.begin()+finiteCount_;
+        const auto end=std::lower_bound(entries_.begin(),finiteEnd,hi.x,
+            [](const Entry& entry,double value){return entry.lower<value;});
+        // Every earlier upper is <= lo.x; none can satisfy upper > lo.x.
+        const auto begin=std::upper_bound(entries_.begin(),end,lo.x,
+            [](double value,const Entry& entry){return value<entry.prefixUpper;});
+        for(auto it=begin;it!=end;++it)if(overlap(lo,hi,*it->solid,.5))return true;
+        // Exceptional expanded X bounds never enter binary-search ordering.
+        for(auto it=finiteEnd;it!=entries_.end();++it)if(overlap(lo,hi,*it->solid,.5))return true;
+        return false;
+    }
+};
