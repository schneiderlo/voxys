+// Opt-in actual Cove linear-HDR background, encoded after the current
+// filtered environment is bound. Depth-zero and sky preserve legacy seeding.
+@fragment
+fn fsBackgroundCove(i : VSOut) -> @location(0) vec4<f32> {
+    let dims = textureDimensions(depthTex, 0);
+    let pixel = clamp(vec2<i32>(floor(i.uv * vec2<f32>(dims))), vec2<i32>(0), vec2<i32>(dims) - 1);
+    let depth = textureLoad(depthTex, pixel, 0).x;
+    if (depth < 0.0) {
+        return vec4<f32>(backgroundSky(pixel, dims), 1.0);
+    }
+    if (depth > 0.0) {
+        return vec4<f32>(backgroundCoveTerrain(pixel, dims, depth, 1.0), 1.0);
+    }
+    return vec4<f32>(backgroundTerrain(pixel, dims, depth, 1.0, 1.0), 1.0);
+}
