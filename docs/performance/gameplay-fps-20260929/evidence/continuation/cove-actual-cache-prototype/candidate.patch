+bool BlitPath::refreshBackground(WGPUCommandEncoder encoder, bool cove,
+                                 WGPUBindGroup shadows, WGPUQuerySet query,
+                                 uint32_t beginQuery, bool& timestampStarted) {
+    if (!encoder || !backgroundView_ || !staticBindGroup_ || !staticUniforms_) return false;
+    if (cove && (!coveBackgroundPipeline_ || !shadows || !sceneEnvironmentBindings_)) return false;
+    if (backgroundValid_ && !backgroundDirty_ && backgroundIsCove_ == cove) return true;
+    if (staticUniformsDirty_) {
+        if (!gpu::writeBuffer(queue_, staticUniformBuffer_, 0, *staticUniforms_)) return false;
+        staticUniformsDirty_ = false;
+    }
+    WGPURenderPassColorAttachment target{};
+    target.view = backgroundView_;
+    target.depthSlice = WGPU_DEPTH_SLICE_UNDEFINED;
+    target.loadOp = WGPULoadOp_Clear;
+    target.storeOp = WGPUStoreOp_Store;
+    target.clearValue = {0.0, 0.0, 0.0, 1.0};
+    WGPURenderPassDescriptor descriptor{};
+    WGPU_SET_LABEL(descriptor, "blit_static_background_pass");
+    descriptor.colorAttachmentCount = 1;
+    descriptor.colorAttachments = &target;
+    gpu::CompatRenderPassTimestampWrites timestamps{};
+    if (query && beginQuery != WGPU_QUERY_SET_INDEX_UNDEFINED) {
+        timestamps.querySet = query;
+        timestamps.beginningOfPassWriteIndex = beginQuery;
+        timestamps.endOfPassWriteIndex = WGPU_QUERY_SET_INDEX_UNDEFINED;
+        descriptor.timestampWrites = &timestamps;
+    }
+    auto pass = wgpuCommandEncoderBeginRenderPass(encoder, &descriptor);
+    if (!pass) return false;
+    wgpuRenderPassEncoderSetPipeline(pass, cove ? coveBackgroundPipeline_ : backgroundPipeline_);
+    wgpuRenderPassEncoderSetBindGroup(pass, 0, staticBindGroup_, 0, nullptr);
+    if (cove) {
+        wgpuRenderPassEncoderSetBindGroup(pass, 1, shadows, 0, nullptr);
+        wgpuRenderPassEncoderSetBindGroup(pass, 2, sceneEnvironmentBindings_, 0, nullptr);
+    }
+    wgpuRenderPassEncoderDraw(pass, 3, 1, 0, 0);
+    wgpuRenderPassEncoderEnd(pass);
+    wgpuRenderPassEncoderRelease(pass);
+    backgroundValid_ = true;
+    backgroundDirty_ = false;
+    backgroundIsCove_ = cove;
+    timestampStarted = query && beginQuery != WGPU_QUERY_SET_INDEX_UNDEFINED;
+    // RenderFrameGuard calls discardEncoding if this encoder is not submitted.
     return true;
 }
 
